# Public Firebase Web configuration. These values identify the Firebase project,
# but do not grant privileged access. Configure them in Vercel for each environment.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Never prefix these with a public client prefix.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only M-Pesa provider integration. The exact provider adapter, callback signing
# contract, and credentials must be configured only after provider documentation is supplied.
# Never expose these to browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MPESA_API_BASE_URL=
MPESA_API_KEY=
MPESA_API_SECRET=
MPESA_WEBHOOK_SECRET=
MPESA_PROVIDER_ADAPTER=
