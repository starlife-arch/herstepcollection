# Public Firebase Web configuration. These values identify the Firebase project,
# but do not grant privileged access. Configure them in Vercel for each environment.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Never prefix these with a public client prefix.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only Cloudinary configuration. Never expose private credentials to browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Server-only PrintPay configuration. PRINTPAY_API_BASE_URL defaults to https://printpay.site/api.
# PrintPay documents no webhook-signature secret; do not invent or configure one.
PRINTPAY_API_KEY=
PRINTPAY_API_BASE_URL=https://printpay.site/api

# Server-only Brevo transactional email and marketing contact configuration.
BREVO_API_KEY=
BREVO_SENDER_DOMAIN=herstep.co.ke
BREVO_SENDER_HELLO=hello@herstep.co.ke
BREVO_SENDER_SUPPORT=support@herstep.co.ke
BREVO_SENDER_ORDERS=orders@herstep.co.ke
BREVO_SENDER_NAME=HerStep Collection
BREVO_REPLY_TO_EMAIL=
BREVO_LIST_ID=
