{
  "version": 2,
  "builds": [
    { "src": "api/admin.js", "use": "@vercel/node" },
    { "src": "api/catalog.js", "use": "@vercel/node" },
    { "src": "api/orders.js", "use": "@vercel/node" },
    { "src": "api/users.js", "use": "@vercel/node" },
    { "src": "api/payments.js", "use": "@vercel/node" },
    { "src": "api/support.js", "use": "@vercel/node" },
    { "src": "api/requests.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/admin/analytics", "dest": "/api/admin.js?route=analytics" },
    { "src": "/api/admin/announcement", "dest": "/api/admin.js?route=announcement" },
    { "src": "/api/admin/audit-logs", "dest": "/api/admin.js?route=audit-logs" },
    { "src": "/api/admin/brevo-contacts", "dest": "/api/admin.js?route=brevo-contacts" },
    { "src": "/api/admin/dashboard", "dest": "/api/admin.js?route=dashboard" },
    { "src": "/api/admin/orders", "dest": "/api/admin.js?route=orders" },
    { "src": "/api/admin/requests", "dest": "/api/admin.js?route=requests" },
    { "src": "/api/announcement", "dest": "/api/catalog.js?route=announcement" },
    { "src": "/api/categories", "dest": "/api/catalog.js?route=categories" },
    { "src": "/api/firebase-config", "dest": "/api/catalog.js?route=firebase-config" },
    { "src": "/api/media/sign-upload", "dest": "/api/catalog.js?route=media-sign-upload" },
    { "src": "/api/promo-codes", "dest": "/api/catalog.js?route=promo-codes" },
    { "src": "/api/products", "dest": "/api/catalog.js?route=products" },
    { "src": "/api/products/([^/]+)", "dest": "/api/catalog.js?route=product-detail&id=$1" },
    { "src": "/api/promotions", "dest": "/api/catalog.js?route=promotions" },
    { "src": "/api/checkout/config", "dest": "/api/orders.js?route=checkout-config" },
    { "src": "/api/orders/create", "dest": "/api/orders.js?route=create" },
    { "src": "/api/orders/status", "dest": "/api/orders.js?route=status" },
    { "src": "/api/orders/track", "dest": "/api/orders.js?route=track" },
    { "src": "/api/auth/otp/request", "dest": "/api/users.js?route=otp-request" },
    { "src": "/api/auth/otp/verify", "dest": "/api/users.js?route=otp-verify" },
    { "src": "/api/auth/sync-profile", "dest": "/api/users.js?route=sync-profile" },
    { "src": "/api/dashboard", "dest": "/api/users.js?route=dashboard" },
    { "src": "/api/notifications", "dest": "/api/users.js?route=notifications" },
    { "src": "/api/payments/mpesa/callback", "dest": "/api/payments.js?route=callback" },
    { "src": "/api/payments/receipt", "dest": "/api/payments.js?route=receipt" },
    { "src": "/api/payments/status", "dest": "/api/payments.js?route=status" },
    { "src": "/api/payments/stk/initiate", "dest": "/api/payments.js?route=initiate" },
    { "src": "/api/support", "dest": "/api/support.js?route=support" },
    { "src": "/api/support/admin", "dest": "/api/support.js?route=admin" },
    { "src": "/api/support/messages", "dest": "/api/support.js?route=messages" },
    { "src": "/api/support/status", "dest": "/api/support.js?route=status" },
    { "src": "/api/requests/bulk", "dest": "/api/requests.js?route=bulk" },
    { "src": "/api/requests/discount", "dest": "/api/requests.js?route=discount" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
